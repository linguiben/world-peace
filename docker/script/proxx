#!/usr/bin/env bash
# ====== 基本配置（修改这里） ======
#cd "$(dirname "$0")"
cd "$(dirname "$(readlink -f "$0")")"
. .env
# 本地 SOCKS 端口
LOCAL_PORT=16800
if [ "$2" != "" ]; then
  LOCAL_PORT=$2
fi

# 是否自动设置 Mac 系统代理（true/false）
ENABLE_SYSTEM_PROXY=true

# Wi-Fi 名称（Mac 一般是 Wi-Fi，如是 Ethernet 请改）
NETWORK_SERVICE="Wi-Fi"

# alias proxy-on="~/scripts/ecs-proxy.sh on"
# alias proxy-off="~/scripts/ecs-proxy.sh off"
# alias proxy-status="~/scripts/ecs-proxy.sh status"
# alias proxy-restart="~/scripts/ecs-proxy.sh restart"

# ssh -D 1080 sg.joveso.com
# [root@iZt4n3oaftioxvvbmvy9v7Z ~]# # proxy openned

# export ALL_PROXY=socks5://127.0.0.1:1080
# export ALL_PROXY=socks5h://127.0.0.1:1080 # support DNS 
# export HTTP_PROXY=http://127.0.0.1:1080
# export HTTPS_PROXY=https://127.0.0.1:1080
# echo "当前出口IP: $(curl -s --max-time 1 ifconfig.me)"
# curl https://ifconfig.me #45.77.249.90
# curl -v --socks5-hostname 127.0.0.1:1080 https://api.openai.com

# ==================================

PID_FILE="/tmp/ecs_socks_proxy.pid"

status_proxy() {
    xxnet_pid=`ps aux | grep -i python3 | grep start.py | awk {'print $2'}`
    if [ -n "$xxnet_pid" ]; then
        echo "🟢 xxnet is running at PID: $xxnet_pid"
        #echo "当前出口IP: `curl -s --max-time 1 ifconfig.me`"
    else
        echo "🔴 xxnet is NOT running"
    fi

    self_proxx=`lsof -nP -i TCP:${LOCAL_PORT} -sTCP:LISTEN` >/dev/null 2>&1
    if [ -z self_proxx ]; then
        echo -e "🟢 self-proxx is running at:\n${self_proxx}"
    else
        echo "🔴 self-proxx is NOT running"
    fi

    expressvpn_proxy=`ps aux | grep ExpressVPN.app/Contents/MacOS/ExpressVPN | grep -v grep` >/dev/null 2>&1
    if [ -n "$expressvpn_proxy" ]; then
        echo -e "🟢 ExpressVPN is running at:\n${expressvpn_proxy}"
    else
        echo "🔴 ExpressVPN is NOT running"
    fi

    clash_verge_proxy=`netstat -anv | grep verge-mihomo: | grep LISTEN | awk '{print $1,$4,$5,$6,$11}'` >/dev/null 2>&1
    if [ -n "$clash_verge_proxy" ]; then
        echo -e "🟢 Clash Verge is running at:\n${clash_verge_proxy}"
    else
        echo "🔴 Clash Verge is NOT running"
    fi

    echo "本机出口`curl -s --proxy '' http://ip-api.com/json/ | jq -r '"IP: \(.query); 归属地: \(.country), \(.regionName), \(.city)"'`"
    echo "代理出口`curl -s -x http://127.0.0.1:8086 http://ip-api.com/json/ | jq -r '"IP: \(.query); 归属地: \(.country), \(.regionName), \(.city)"'`"
}

start_proxy() {
    if lsof -nP -i TCP:${LOCAL_PORT} -sTCP:LISTEN >/dev/null 2>&1; then
        echo "⚠️  端口 ${LOCAL_PORT} 已被占用，可能代理已在运行"
        return
    fi

    proxx_cmd="ssh -D ${LOCAL_PORT} \
        -C -N \
        -p ${SSH_PORT} \
        -o ServerAliveInterval=60 \
        -o ServerAliveCountMax=3 \
        ${ECS_USER}@${ECS_HOST}"
    echo "🚀 startup SSH SOCKS @${SSH_PORT} ..."
    $proxx_cmd

    SSH_PID=$!
    echo $SSH_PID > "${PID_FILE}"

    sleep 1

    if ps -p $SSH_PID > /dev/null; then
        echo "✅ 代理已启动 (PID: $SSH_PID)"
    else
        echo "❌ 代理启动失败"
        return
    fi

    if [ "$ENABLE_SYSTEM_PROXY" = true ]; then
        echo "🔧 设置系统 SOCKS 代理..."
        networksetup -setsocksfirewallproxy "${NETWORK_SERVICE}" 127.0.0.1 ${LOCAL_PORT}
        networksetup -setsocksfirewallproxystate "${NETWORK_SERVICE}" on
        echo "✅ 系统设置: 使用代理"
        status_proxy
    fi
}

stop_proxy() {
    if [ -f "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        if ps -p $PID > /dev/null 2>&1; then
            kill $PID
            echo "🛑 已停止代理 (PID: $PID)"
        fi
        rm -f "${PID_FILE}"
    else
        pkill -f "ssh -D ${LOCAL_PORT}"
        echo "🛑 已尝试关闭所有 SOCKS 代理进程"
    fi

    if [ "$ENABLE_SYSTEM_PROXY" = true ]; then
        echo "🔧 关闭系统 SOCKS 代理..."
        networksetup -setsocksfirewallproxystate "${NETWORK_SERVICE}" off
        echo "✅ 系统设置: 已取消"
    fi
}

start_xxnet() {
  sudo /Users/jupiter/19.git-repo/xx-net/XX-Net-5.16.6/start
  xxnet_pid=`ps aux | grep -i python3 | grep start.py | awk {'print $2'}`
  echo "started on PID: $xxnet_pid"
}

case "$1" in
    on)
        start_proxy
        ;;
    off)
        stop_proxy
        ;;
    status)
        status_proxy
        ;;
    restart)
        stop_proxy
        sleep 1
        start_proxy
        ;;
    xxnet)
        start_xxnet
        ;;
    *)
        echo "Usage: $0 {xxnet|on|off|status|restart} [port:16800]"
        ;;
esac
